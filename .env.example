SECRET_KEY=replace-with-a-long-random-secret-before-deploying
FRONTEND_URL=http://localhost:5173
# Set SMTP values from your mail provider; reset requests return 503 until configured.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true
PASSWORD_RESET_EXPIRE_MINUTES=30
# Local demo setup only; leave false in shared or production deployments.
SEED_DEMO_DONORS=true
